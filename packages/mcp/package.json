{
  "name": "@hahlex/millar-mcp",
  "version": "0.3.0-draft.1",
  "description": "Millar MCP Server (MCP 2026-07-28): millar:// Resources, 13 Tools, 12 Prompts, and 9 bundled Millar Agent Skills (v0.7.0, including millar-autonomous-qa and millar-diagnose-and-harden) powered by Millar's Single Source of Truth.",
  "license": "MIT",
  "homepage": "https://hahlex.com/millar",
  "repository": {
    "type": "git",
    "url": "https://github.com/hahlex/millar.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "millar-mcp": "./dist/stdio.js",
    "millar-mcp-http": "./dist/http.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hahlex/millar-core": "workspace:*",
    "@hahlex/millar-tokens": "workspace:*",
    "@hahlex/millar-validator": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit"
  }
}
