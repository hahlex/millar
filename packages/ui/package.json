{
  "name": "@hahlex/millar-ui",
  "version": "0.1.0-draft.1",
  "description": "Millar Product/App Design System: Accessible React 19 primitives, semantic 1.5px icon registry, and Ant Design 6 theme adapter.",
  "license": "MIT",
  "homepage": "https://hahlex.com/millar",
  "repository": {
    "type": "git",
    "url": "https://github.com/hahlex/millar.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./antd": {
      "types": "./dist/antd-adapter.d.ts",
      "import": "./dist/antd-adapter.js"
    },
    "./registry": "./dist/registry.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hahlex/millar-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/registry.json','dist/registry.json')\"",
    "typecheck": "tsc --noEmit"
  }
}
