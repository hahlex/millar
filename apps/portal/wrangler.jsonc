{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "millar-portal",
  "main": "./worker.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "millar.hahlex.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
